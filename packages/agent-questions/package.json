{
  "name": "@muzluk/agent-questions",
  "version": "0.1.0",
  "description": "A swipeable React question reel for agent follow-ups, with choices, text, scales, time, and a tactile mood wheel.",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "files": ["dist", "README.md"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "require": "./dist/schema.cjs"
    },
    "./styles.css": "./dist/agent-questions.css"
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly --outDir dist && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run ../../packages/agent-questions/test"
  },
  "dependencies": {
    "@muzluk/mood-wheel": "^0.1.0",
    "zod": "^4.4.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^8.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iyiolacak/mood-wheel.git",
    "directory": "packages/agent-questions"
  },
  "keywords": [
    "agent-question-ui",
    "agent-questions",
    "clarifying-questions",
    "follow-up-questions",
    "mood-wheel",
    "react",
    "ai-ui"
  ]
}
