{
  "name": "muzluk-question-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck && npm run test && npm run build && npm run pack:check",
    "dev": "npm run dev --workspace @muzluk/examples-react",
    "pack:check": "npm pack --dry-run --workspace @muzluk/mood-wheel && npm pack --dry-run --workspace @muzluk/agent-questions",
    "test": "vitest run",
    "typecheck": "npm run build --workspace @muzluk/mood-wheel && npm run build --workspace @muzluk/agent-questions && npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.8"
}
